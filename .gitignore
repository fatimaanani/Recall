# Python
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Environment files (never commit real secrets; .env.example files are tracked)
.env
.env.local
*.env
!.env.example

# Backend runtime data (real uploaded media, generated clips/thumbnails,
