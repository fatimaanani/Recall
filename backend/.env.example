# Copy this file to .env and fill in real values. .env is never committed.

# PostgreSQL connection string used by SQLAlchemy and Alembic.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scene_retrieval

# dev | test | prod , toggles debug behavior in app/config.py
ENVIRONMENT=dev

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Python logging level for backend/logs/app.log
LOG_LEVEL=INFO

# Signing key for JWT access tokens. Generate a real random value for your
# own .env, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this placeholder, and never commit the real value.
JWT_SECRET_KEY=change-this-to-a-random-secret-in-your-own-env
JWT_ALGORITHM=HS256
# Access token lifetime, in minutes.
JWT_EXPIRE_MINUTES=60

# Uploads module. Both have defaults in app/config.py, so these two lines
# are optional , only set them if you want uploaded files stored somewhere
# other than backend/storage/, or a per-file size cap other than 5 GiB.
# STORAGE_ROOT=storage
# MAX_UPLOAD_SIZE_BYTES=5368709120

# Media processing module. Requires FFmpeg (which includes ffprobe)
# installed separately , this is a system dependency, not a pip package.
# On Windows: download a build from https://www.gyan.dev/ffmpeg/builds/
# (the "essentials" or "full" release build), extract it, and add its
# bin/ folder to your PATH (System Properties -> Environment Variables ->
# Path -> New), then open a new terminal and confirm with
# `ffmpeg -version` and `ffprobe -version`. Both lines below are optional
# , only set them if ffmpeg/ffprobe aren't on PATH under their default names.
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe

# Whisper transcription stage (requires faster-whisper, added to
# requirements.txt , no separate system dependency beyond FFmpeg above,
# which this stage also uses to extract each video's audio track first).
# All four lines below are optional , these are already the defaults,
# tuned for a CPU-only developer laptop. WHISPER_MODEL_SIZE can be any
# faster-whisper model name (tiny, base, small, medium, large-v3, ...);
# bigger is slower but more accurate. Set WHISPER_DEVICE=cuda (with a
# matching WHISPER_COMPUTE_TYPE, e.g. float16) only if you have a working
# CUDA setup.
# WHISPER_MODEL_SIZE=tiny
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# PROCESSING_TEMP_DIR=storage/tmp

# Hard ceiling (in seconds) on one video's Whisper transcription, run in
# its own subprocess so a hang can be detected and terminated instead of
# leaving a video stuck at PROCESSING forever. Optional , 7200 (2 hours)
# is already the default, generous for the tiny/CPU setup above. Lower
# this on a faster machine, or raise it if you move to a much larger model.
# WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS=7200

# Whisper hallucination/reliability validation (app/services/
# media_processing_service.py). Whisper can produce fluent-sounding
# filler text over silence/music instead of reporting nothing, so these
# thresholds decide which segments count as real speech before a
# transcript is accepted , tune them here without touching any code.
# All six lines below are optional , these are already the defaults.
# WHISPER_MAX_NO_SPEECH_PROB=0.6
# Stage 1 song-transcript fix: hard ceiling that the no-speech relief rule
# can never override, even when a segment's other signals look clean.
# WHISPER_HARD_MAX_NO_SPEECH_PROB=0.9
# WHISPER_MIN_AVG_LOGPROB=-1.0
# WHISPER_MAX_COMPRESSION_RATIO=2.4
# WHISPER_MAX_WORDS_PER_SECOND=4.0
# WHISPER_REPETITION_SIMILARITY=0.85
# WHISPER_MAX_REPETITION_RATIO=0.60

# Embedding generation stage (app/processing/embedding_processor.py),
# requires sentence-transformers, added to requirements.txt. Runs
# automatically after Whisper transcription, populating
# transcript_segments.embedding for semantic search. All three lines below
# are optional , already the defaults. EMBEDDING_MODEL_NAME must keep
# producing 384-dimensional vectors (matching the Vector(384) column) if
# you ever change it. Set EMBEDDING_DEVICE=cuda (with a working CUDA setup)
# for faster encoding on a large library.
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32

# Search module (app/services/search_service.py) , exact-text (PostgreSQL
# full-text search) and semantic (pgvector) retrieval, merged by a shared
# hybrid-ranking formula. All three lines below are optional , already the
# defaults. SEARCH_TOP_K_DEFAULT caps how many results POST /api/search
# returns when the request doesn't specify its own limit (1-100, enforced
# by the request schema regardless of this default). HYBRID_KEYWORD_WEIGHT/
# HYBRID_SEMANTIC_WEIGHT blend keyword_score and semantic_score into one
# confidence_score when a caller runs both retrieval branches on the same
# query. Typed-text search (POST /api/search) still only ever runs one
# branch per request (exact_text or semantic, user-selected); Speech-to-
# Text search (POST /api/search/speech) is the first live caller that runs
# both and uses this blend for real , see backend/README.md. Provisional
# 0.5/0.5 split, no evaluation data yet to justify anything else. Both must
# be >= 0 and sum to > 0, or the app fails to start with a clear error
# instead of silently ranking nonsense.
# SEARCH_TOP_K_DEFAULT=20
# HYBRID_KEYWORD_WEIGHT=0.5
# HYBRID_SEMANTIC_WEIGHT=0.5

# Speech-to-Text query audio (app/services/search_service.py,
# POST /api/search/speech) , deliberately separate from MAX_UPLOAD_SIZE_BYTES
# above (that's for video/audio uploads, 5 GiB default) and
# WHISPER_TRANSCRIPTION_TIMEOUT_SECONDS above (that's for background video
# processing, 7200s/2 hours default). A search query is a short spoken
# phrase submitted in a live HTTP request, not a media upload, so both
# limits here are much smaller. Both lines are optional , already the
# defaults. QUERY_AUDIO_MAX_SIZE_BYTES=10485760 is 10 MiB.
# QUERY_AUDIO_MAX_SIZE_BYTES=10485760
# QUERY_TRANSCRIPTION_TIMEOUT_SECONDS=60

# Clip generation (app/services/match_resolver.py + clip_service.py,
# POST /api/results/{id}/clip).
# Reuses STORAGE_ROOT above , clips are written under
# storage_root/clips/{video_id}/{server-generated-uuid}.{mp4|mp3}, no
# separate clip storage setting. All six lines are optional , already the
# defaults. CLIP_PRE_BUFFER_SECONDS/CLIP_POST_BUFFER_SECONDS pad the
# matched transcript segment before cutting. CLIP_MAX_MERGE_GAP_SECONDS
# controls boundary snapping: if the buffered edge lands within this many
# seconds of an immediately-adjacent transcript segment's own boundary,
# the clip snaps outward to that segment's edge instead of cutting it
# mid-way (one hop only, never a multi-segment merge).
# CLIP_MIN_DURATION_SECONDS/CLIP_MAX_DURATION_SECONDS bound the final clip
# length, centered on the matched interval's own midpoint when expansion
# or trimming is needed. CLIP_GENERATION_TIMEOUT_SECONDS is FFmpeg's
# timeout for a live HTTP request (short, like
# QUERY_TRANSCRIPTION_TIMEOUT_SECONDS above , not the 7200s background
# video-processing timeout). Validated at startup: all must be >= 0,
# CLIP_MIN_DURATION_SECONDS must not exceed CLIP_MAX_DURATION_SECONDS, and
# the timeout must be > 0.
# CLIP_PRE_BUFFER_SECONDS=3.0
# CLIP_POST_BUFFER_SECONDS=3.0
# CLIP_MIN_DURATION_SECONDS=5.0
# CLIP_MAX_DURATION_SECONDS=120.0
# CLIP_GENERATION_TIMEOUT_SECONDS=60
# CLIP_MAX_MERGE_GAP_SECONDS=1.0

# Elasticsearch (app/services/elasticsearch_service.py) , EVALUATION ONLY,
# never used by real user search. Disabled by default: leave
# ELASTICSEARCH_ENABLED=False (or unset) until you've installed a local
# Elasticsearch server , normal app startup and live search work fully
# without it either way. See backend/README.md's Elasticsearch setup
# tutorial for the full Windows install walkthrough.
# ELASTICSEARCH_ENABLED=False
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=change-this-to-your-real-local-password
# ELASTICSEARCH_INDEX_NAME=recall_evaluation_segments
# ELASTICSEARCH_TIMEOUT_SECONDS=10

# Integration tests only (backend/tests/) , a second, separate PostgreSQL
# database (with the vector extension available) used to verify real
# pgvector persistence and the embedding backfill against Postgres itself,
# not a mock. Unit tests never need this. If unset, those specific
# integration tests are skipped rather than failing , see
# backend/tests/README.md.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/scene_retrieval_test

# Real-FFmpeg integration tests only (backend/tests/test_clip_service.py) ,
# separate from TEST_DATABASE_URL above. Unset by default, so an ordinary
# `pytest` run never requires a working FFmpeg install; these tests also
# auto-skip if the configured FFMPEG_BINARY isn't found on PATH even when
# this is set. Set to "1" to actually cut a tiny real video and audio clip
# and confirm the output is a valid, non-empty, roughly-correct-duration
# file via ffprobe.
# RUN_FFMPEG_INTEGRATION_TESTS=1
